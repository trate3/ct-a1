+# HuggingFace id for the Gemma 4 31B instruct model. The tokenizer is ungated; the weights are
+# only needed when actually running the model (omit_model=False).
+GEMMA4_MODEL_ID = "google/gemma-4-31B-it"
+
+# Per-size checkpoints. Gemma 4 is Apache-2.0 and ungated, so none of these need a token.
+GEMMA4_MODEL_IDS = {
+    31: "google/gemma-4-31B-it",
+    4: "google/gemma-4-E4B-it",
+}
+
+
+def gemma4_model_id(model_name: ModelName) -> str:
+    return GEMMA4_MODEL_IDS[model_name.size]
+
+
+@cache
+def get_gemma4_model_and_tokenizer(
+    model_name: ModelName,
+    omit_model: bool = False,
+) -> tuple[PreTrainedModel | None, PreTrainedTokenizerBase]:
+    """Return Gemma 4 model and tokenizer.
+
+    The tokenizer source can be overridden with the GEMMA4_TOKENIZER_PATH env var, which is useful
+    for offline work (e.g. pointing at a local directory holding just the tokenizer files) without
+    needing the model weights.
+    """
+    if not model_name.type == "gemma4":
+        raise ValueError(f"Expected Gemma 4 model, got {model_name}")
+
+    load_dotenv()  # for hf token
+    tokenizer_src = os.environ.get("GEMMA4_TOKENIZER_PATH", gemma4_model_id(model_name))
+    tokenizer = AutoTokenizer.from_pretrained(tokenizer_src, padding_side="left")
+    # follow the repo convention of using bos as the pad token (see get_str_tokens)
+    tokenizer.pad_token_id = tokenizer.bos_token_id
+
+    if omit_model:
+        return None, tokenizer
+
+    # Cache dir is configurable (GEMMA4_CACHE_DIR) so the weights can live on whatever disk is
+    # writable; defaults to the repo convention of /data/huggingface.
+    # Default to the standard HF cache rather than Apollo's cluster path: with
+    # local_files_only forced on, an unset GEMMA4_CACHE_DIR made a first-time download
+    # impossible on any machine that is not their cluster.
+    cache_dir = os.environ.get("GEMMA4_CACHE_DIR") or None
+    # attn impl is env-configurable: eager is safe for Gemma soft-capping, but Gemma 4 may not use
+    # attention soft-capping, in which case sdpa is substantially faster for generation.
+    model_kwargs: dict[str, object] = {
+        "device_map": "auto",
+        "attn_implementation": os.environ.get("GEMMA4_ATTN", "eager"),
+        "cache_dir": cache_dir,
+        "local_files_only": os.environ.get("GEMMA4_LOCAL_ONLY", "0") == "1",
+    }
+    # GEMMA4_LOAD_4BIT=1 loads an nf4 4-bit quantization that fits entirely in 24GB of VRAM.
+    # This is intended for *generation* (needs all 60 layers, otherwise offloads to CPU at
+    # ~0.3 tok/s). Faithful activation extraction for the probe should use bf16 (default) with
+    # cut_at_layer, which fits on-GPU without quantization.
+    if os.environ.get("GEMMA4_LOAD_4BIT", "0") == "1":
+        from transformers import BitsAndBytesConfig
+
+        model_kwargs["quantization_config"] = BitsAndBytesConfig(
+            load_in_4bit=True,
+            bnb_4bit_quant_type="nf4",
+            bnb_4bit_compute_dtype=torch.bfloat16,
+            bnb_4bit_use_double_quant=True,
+        )
+    else:
+        model_kwargs["torch_dtype"] = torch.bfloat16
+    model = AutoModelForCausalLM.from_pretrained(  # type: ignore
+        gemma4_model_id(model_name), **model_kwargs)
+
+    logger.info(f"Loaded model {model_name}")
+
+    if model.device == torch.device("cpu"):
+        logger.warning("Model is on CPU")
+
+    model.eval()
+    return model, tokenizer
+
